<div class="block-continue-learning">
    {{#hascategories}}
        <div class="continue-learning-category-grid">
            {{#categories}}
                <a class="continue-learning-card continue-learning-category-card {{#selected}}is-active{{/selected}}" href="{{url}}">
                    <div class="card-body">
                        <div class="card-title">{{name}}</div>
                        <div class="category-meta">{{coursecount}} {{#str}} courselabel, block_continue_learning {{/str}}</div>
                    </div>
                </a>
            {{/categories}}
        </div>

        {{#hasselectedcourses}}
            <div class="continue-learning-grid">
                {{#selectedcourses}}
                    <a class="continue-learning-card" href="{{url}}">
                        {{#showimages}}
                            <div class="card-image">
                                {{#imageurl}}
                                    <img src="{{imageurl}}" alt="{{name}}">
                                {{/imageurl}}
                                {{^imageurl}}
                                    <div class="image-placeholder" aria-hidden="true"></div>
                                {{/imageurl}}
                            </div>
                        {{/showimages}}
                        <div class="card-body">
                            <div class="card-title">{{name}}</div>
                            {{#showprogress}}
                                <div class="progress-wrap" role="progressbar" aria-valuenow="{{progress}}" aria-valuemin="0" aria-valuemax="100" aria-label="{{#str}} progresslabel, block_continue_learning {{/str}}">
                                    <div class="progress-bar" style="width: {{progress}}%"></div>
                                </div>
                                <div class="progress-value">{{progress}}%</div>
                            {{/showprogress}}
                        </div>
                    </a>
                {{/selectedcourses}}
            </div>
        {{/hasselectedcourses}}
        {{^hasselectedcourses}}
            <div class="continue-learning-empty">{{#str}} nocoursesincategory, block_continue_learning {{/str}}</div>
        {{/hasselectedcourses}}
    {{/hascategories}}
    {{^hascategories}}
        <div class="continue-learning-empty">{{#str}} nocategories, block_continue_learning {{/str}}</div>
    {{/hascategories}}
</div>
